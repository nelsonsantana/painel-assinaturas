# Essas variáveis são configuradas direto no painel da Vercel
# (Settings > Environment Variables), não precisa de arquivo .env
# em produção. Isso aqui é só referência.

# Senha que você digita pra entrar na página
PAGE_PASSWORD=escolha_uma_senha_forte

# Segredo compartilhado entre o script local e o endpoint /api/ingest
# Gere um valor aleatório, ex: rode no terminal:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INGEST_SECRET=gere_um_valor_aleatorio_aqui

# Preenchidas automaticamente quando você conecta um banco Upstash
# Redis ao projeto pela aba "Storage" da Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Botão "Renovar" (chama o servidor de ações rodando na VM) ---
# URL completa do endpoint /renovar exposto pela VM
RENOVAR_URL=http://SEU_IP_DA_VM:3001/renovar
# Precisa ser IGUAL ao RENOVAR_SECRET configurado no .env do cronos-assinaturas
RENOVAR_SECRET=mesmo_valor_aleatorio_do_cronos_assinaturas

# --- Botão "Verificar agora" (roda o fluxo completo de verificação na
# VM: exporta a planilha, calcula vencimentos, manda Telegram e
# atualiza este painel). Mesmo servidor e mesmo RENOVAR_SECRET acima. ---
VERIFICAR_URL=http://SEU_IP_DA_VM:3001/verificar
